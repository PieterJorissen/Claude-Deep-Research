{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "deepresearch": {
      "type": "local",
      "command": ["uv", "run", "--quiet", "--project", ".", "deep_research.py"],
      "cwd": ".",
      "enabled": true,
      "timeout": 60000,
      "environment": {
        "PYTHONUTF8": "1",
        "PYTHONIOENCODING": "utf-8",
        "DEEP_RESEARCH_MAX_CONTENT": "16000",
        "DEEP_RESEARCH_MAX_RESULTS": "3"
      }
    }
  }
}
